<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OSFR.Linux.LauncherDemo.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="Background" Value="#101010" />
      <Setter Property="Foreground" Value="#F3F3F3" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="Foreground" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#343434" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="13,10" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="Foreground" Value="#59D483" />
      <Setter Property="BorderBrush" Value="#38433C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#202923" />
      <Setter Property="BorderBrush" Value="#45B86B" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2F9E5A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#54D27E" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="28,13" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#38B866" />
    </Style>
  </Application.Styles>
</Application>

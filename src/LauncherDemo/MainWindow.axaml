<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OSFR.Linux.LauncherDemo.MainWindow"
        Title="Sanctuary Linux Launcher"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        Background="#0B0E0C">

  <Grid ColumnDefinitions="300,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#101512" BorderBrush="#263129" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="22">

        <!-- Branding centered within the full sidebar width. -->
        <StackPanel Grid.Row="0"
                    Width="256"
                    HorizontalAlignment="Center"
                    Spacing="4"
                    Margin="0,22,0,34">

          <Border Width="88" Height="88"
                  HorizontalAlignment="Center"
                  CornerRadius="44"
                  BorderBrush="#35D06F" BorderThickness="2"
                  Background="#151D18"
                  Margin="0,0,0,14">
            <TextBlock Text="S"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="45"
                       FontWeight="Bold"
                       Foreground="#35D06F" />
          </Border>

          <TextBlock Text="SANCTUARY"
                     HorizontalAlignment="Stretch"
                     TextAlignment="Center"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="White" />

          <TextBlock Text="LINUX LAUNCHER"
                     HorizontalAlignment="Stretch"
                     TextAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="#35D06F" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
          <Button Content="Home" HorizontalContentAlignment="Left" Padding="16,12" />
          <Button Content="Servers" HorizontalContentAlignment="Left" Padding="16,12" />
          <Button Content="Settings" HorizontalContentAlignment="Left" Padding="16,12" />
          <Button Content="About" HorizontalContentAlignment="Left" Padding="16,12" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5" HorizontalAlignment="Center">
          <TextBlock Text="NORTHFORGE" HorizontalAlignment="Center" TextAlignment="Center"
                     FontWeight="SemiBold" Foreground="#35D06F" />
          <TextBlock Text="SANCTUARY NETWORK" HorizontalAlignment="Center" TextAlignment="Center"
                     FontSize="11" Foreground="#89948D" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Reconstructed main shell. Launcher behavior will be restored incrementally. -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="42,34" Spacing="24">
        <StackPanel Spacing="4">
          <TextBlock Text="Welcome to Sanctuary" FontSize="34" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Select a server and launch Free Realms." FontSize="15" Foreground="#A5AEA8" />
        </StackPanel>

        <TextBlock Text="1. SELECT A SERVER" FontSize="15" FontWeight="Bold" Foreground="#35D06F" />
        <Border Padding="20" CornerRadius="10" Background="#121815" BorderBrush="#29352D" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="OSFR Public Server" FontSize="20" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="● Online" Foreground="#35D06F" />
              <TextBlock Text="Server status recovery in progress" Foreground="#89948D" />
            </StackPanel>
            <Button Grid.Column="1" Content="Select" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <TextBlock Text="2. CLIENT STATUS" FontSize="15" FontWeight="Bold" Foreground="#35D06F" />
        <Border Padding="20" CornerRadius="10" Background="#121815" BorderBrush="#29352D" BorderThickness="1">
          <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="4">
              <TextBlock Text="Client verification" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="Recovery implementation pending" Foreground="#89948D" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Proton launcher" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="Recovery implementation pending" Foreground="#89948D" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="3. LAUNCH" FontSize="15" FontWeight="Bold" Foreground="#35D06F" />
        <Button Height="76" Content="▶   LAUNCH SANCTUARY"
                FontSize="22" FontWeight="Bold"
                Background="#219653" Foreground="White" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>

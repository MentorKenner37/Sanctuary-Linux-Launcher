<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OSFR.Linux.LauncherDemo.MainWindow"
        Width="1040" Height="760"
        MinWidth="900" MinHeight="650"
        Title="Sanctuary Linux Launcher"
        Opened="WindowOpened">
  <Grid ColumnDefinitions="250,*">
    <Border Grid.Column="0" Background="#131313" BorderBrush="#292929" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22">
        <StackPanel Spacing="5" HorizontalAlignment="Stretch">
          <Border Width="54" Height="54" HorizontalAlignment="Center" CornerRadius="27" Background="#17151D" BorderBrush="#8B63FF" BorderThickness="2">
            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="#B79BFF" />
          </Border>
          <TextBlock Text="SANCTUARY" FontSize="18" FontWeight="Bold" Foreground="#F4F4F4" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="LINUX LAUNCHER" FontSize="12" FontWeight="SemiBold" Foreground="#55D27E" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,34,0,0" Spacing="8">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="HomeClicked">
            <TextBlock Text="HOME" Foreground="#DADADA" FontWeight="SemiBold" />
          </Button>
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="ServersClicked">
            <TextBlock Text="SERVERS" Foreground="#DADADA" FontWeight="SemiBold" />
          </Button>
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="AboutClicked">
            <TextBlock Text="ABOUT" Foreground="#DADADA" FontWeight="SemiBold" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="10">
          <Border BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="3">
                <TextBlock Text="NORTHFORGE" Foreground="#55D27E" FontWeight="Bold" />
                <TextBlock Text="Sanctuary Linux launcher" FontSize="11" Foreground="#858585" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Settings" Click="SettingsClicked">
                <TextBlock Text="⚙" FontSize="17" Foreground="#BDBDBD" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <StackPanel IsVisible="False">
        <TextBlock x:Name="WebApiText" />
        <TextBlock x:Name="LoginServerText" />
        <TextBlock x:Name="ClientStatusText" />
        <ProgressBar x:Name="ClientProgress" />
        <Button x:Name="VerifyButton" />
      </StackPanel>

      <ScrollViewer x:Name="HomePage">
        <StackPanel Margin="34,30" Spacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="SANCTUARY LINUX LAUNCHER" FontSize="25" FontWeight="Bold" Foreground="#F5F5F5" />
            <TextBlock Text="Choose a server, sign in, and launch. Client verification and updates happen automatically when you join a server." Foreground="#9E9E9E" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="SERVER ADDRESS" FontSize="12" FontWeight="Bold" Foreground="#55D27E" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="ServerUrlBox" Text="https://opensourcefreerealms.com" Watermark="https://server.example" />
                <Button Grid.Column="1" x:Name="ConnectButton" Classes="primary" Content="JOIN SERVER" Click="JoinServerClicked" />
              </Grid>
              <TextBlock x:Name="ConnectionStatusText" Text="Ready to join a server." Foreground="#A0A0A0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="22">
            <Grid ColumnDefinitions="100,*" ColumnSpacing="20">
              <Border Width="92" Height="92" CornerRadius="12" Background="#202020" BorderBrush="#343434" BorderThickness="1">
                <Grid>
                  <Image x:Name="ServerLogoImage" Stretch="UniformToFill" IsVisible="False" />
                  <TextBlock x:Name="ServerLogoFallback" Text="S" FontSize="38" FontWeight="Bold" Foreground="#55D27E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="ServerNameText" Text="No server connected" FontSize="20" FontWeight="Bold" Foreground="#F4F4F4" />
                  <Border Grid.Column="1" Background="#17251B" BorderBrush="#31533C" BorderThickness="1" CornerRadius="12" Padding="10,4">
                    <TextBlock x:Name="OnlineText" Text="OFFLINE" Foreground="#8D8D8D" FontSize="11" FontWeight="Bold" />
                  </Border>
                </Grid>
                <TextBlock x:Name="ServerDescriptionText" Text="Join a server to load its metadata." Foreground="#A6A6A6" TextWrapping="Wrap" />
                <TextBlock x:Name="ManifestVersionText" Text="Manifest: —" Foreground="#55D27E" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ACCOUNT" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
                <CheckBox Grid.Column="1" x:Name="RememberMeCheckBox" Content="Remember me for this server" Foreground="#DADADA" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Username" Foreground="#BDBDBD" FontSize="11" />
                  <TextBox x:Name="UsernameBox" Watermark="Username" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="Password" Foreground="#BDBDBD" FontSize="11" />
                  <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Password" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="RememberStatusText" Text="Remember Me is stored separately for each server. Passwords use the Linux secret service when available; they are never written to preferences.json." Foreground="#747474" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button x:Name="LaunchButton" Classes="primary" Content="LAUNCH SANCTUARY" HorizontalAlignment="Stretch" Height="54" IsEnabled="False" Click="LaunchRememberClicked" />
          <TextBlock x:Name="LaunchStatusText" Text="" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ServersPage" IsVisible="False">
        <StackPanel Margin="34,30" Spacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="SERVERS" FontSize="25" FontWeight="Bold" Foreground="#F5F5F5" />
            <TextBlock Text="Saved servers are checked automatically so you can see which ones are online before joining." Foreground="#9E9E9E" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SAVED SERVERS" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
                <TextBlock Grid.Column="1" x:Name="SavedServerCountText" Text="0 saved servers" Foreground="#8D8D8D" FontSize="11" />
              </Grid>
              <ListBox x:Name="SavedServersList" MinHeight="210">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#191919" BorderBrush="#303030" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" Foreground="#F0F0F0" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Url}" Foreground="#858585" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="1" Content="JOIN SERVER" Classes="primary" Click="JoinSavedServerClicked" />
                <Button Grid.Column="2" Content="REMOVE" Click="RemoveServerClicked" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="ADD SERVER" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="NewServerUrlBox" Watermark="https://server.example" />
                <Button Grid.Column="1" Content="ADD" Classes="primary" Click="AddServerClicked" />
              </Grid>
              <TextBlock Text="A server can only be added if it uses HTTPS, is currently online, and returns a valid Sanctuary server manifest with an HTTPS Web API." Foreground="#747474" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="ServersStatusText" Foreground="#A0A0A0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SettingsPage" IsVisible="False" Loaded="GameDisplaySettingsLoaded">
        <StackPanel Margin="34,30" Spacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="SETTINGS" FontSize="25" FontWeight="Bold" Foreground="#F5F5F5" />
            <TextBlock Text="Launcher and runtime options used when Sanctuary starts." Foreground="#9E9E9E" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="14">
              <TextBlock Text="GAME DISPLAY" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="RESOLUTION" Foreground="#8D8D8D" FontSize="10" />
                  <ComboBox x:Name="ResolutionComboBox" SelectionChanged="GameDisplaySettingChanged">
                    <ComboBoxItem Content="Default (game controlled)" />
                    <ComboBoxItem Content="1280x720" />
                    <ComboBoxItem Content="1366x768" />
                    <ComboBoxItem Content="1600x900" />
                    <ComboBoxItem Content="1920x1080" />
                    <ComboBoxItem Content="2560x1440" />
                    <ComboBoxItem Content="3840x2160" />
                  </ComboBox>
                  <TextBlock Text="Fixed resolutions use Proton's virtual desktop so Free Realms receives the selected display size." Foreground="#747474" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="FRAME RATE LIMIT" Foreground="#8D8D8D" FontSize="10" />
                  <ComboBox x:Name="FrameRateComboBox" SelectionChanged="GameDisplaySettingChanged">
                    <ComboBoxItem Content="Unlimited" />
                    <ComboBoxItem Content="30 FPS" />
                    <ComboBoxItem Content="60 FPS" />
                    <ComboBoxItem Content="75 FPS" />
                    <ComboBoxItem Content="120 FPS" />
                    <ComboBoxItem Content="144 FPS" />
                    <ComboBoxItem Content="165 FPS" />
                    <ComboBoxItem Content="240 FPS" />
                  </ComboBox>
                  <TextBlock Text="The frame limiter is applied through DXVK when Sanctuary launches." Foreground="#747474" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="GameDisplayStatusText" Foreground="#55D27E" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="13">
              <TextBlock Text="INSTALLER RUNTIME" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
              <TextBlock Text="PROTON" Foreground="#8D8D8D" FontSize="10" />
              <TextBlock x:Name="ProtonSettingText" Text="—" Foreground="#E8E8E8" TextWrapping="Wrap" />
              <TextBlock Text="STEAM ROOT" Foreground="#8D8D8D" FontSize="10" />
              <TextBlock x:Name="SteamSettingText" Text="—" Foreground="#E8E8E8" TextWrapping="Wrap" />
              <TextBlock Text="PROTON PREFIX" Foreground="#8D8D8D" FontSize="10" />
              <TextBlock x:Name="PrefixSettingText" Text="—" Foreground="#E8E8E8" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock Text="GRAPHICS BACKEND" Foreground="#8D8D8D" FontSize="10" />
                  <TextBlock x:Name="BackendSettingText" Text="—" Foreground="#E8E8E8" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="DISPLAY MODE" Foreground="#8D8D8D" FontSize="10" />
                  <TextBlock x:Name="DisplaySettingText" Text="—" Foreground="#E8E8E8" />
                </StackPanel>
              </Grid>
              <Button Content="OPEN INSTALLER FOLDER" HorizontalAlignment="Left" Click="OpenInstallerFolderClicked" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="SettingsStatusText" Foreground="#A0A0A0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="AboutPage" IsVisible="False">
        <StackPanel Margin="34,30" Spacing="18">
          <StackPanel Spacing="4">
            <TextBlock Text="ABOUT" FontSize="25" FontWeight="Bold" Foreground="#F5F5F5" />
            <TextBlock Text="Sanctuary Linux Launcher" Foreground="#55D27E" FontSize="16" FontWeight="SemiBold" />
          </StackPanel>

          <Border Background="#151515" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="22">
            <StackPanel Spacing="12">
              <TextBlock Text="SANCTUARY LINUX LAUNCHER" Foreground="#55D27E" FontWeight="Bold" FontSize="12" />
              <TextBlock Text="An independent Linux launcher for Sanctuary-compatible Free Realms servers. It reads existing servermanifest.xml/clientmanifest.xml data, automatically verifies client files when a server is joined, signs in through that server's Web API, and launches through the Proton runtime configured by the Sanctuary Linux Installer." Foreground="#D0D0D0" TextWrapping="Wrap" />
              <TextBlock Text="Compatibility baseline: ServerManifest v1/v2 • ClientManifest v1 • HTTPS server URLs • Proton runtime supplied by installer" Foreground="#9E9E9E" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#111B14" BorderBrush="#31533C" BorderThickness="1" CornerRadius="10" Padding="20">
            <StackPanel Spacing="6">
              <TextBlock Text="NORTHFORGE" Foreground="#55D27E" FontWeight="Bold" />
              <TextBlock Text="Linux launcher and integration work." Foreground="#BDBDBD" />
              <TextBlock Text="This launcher keeps server-specific accounts and saved server entries isolated from one another." Foreground="#7F7F7F" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
